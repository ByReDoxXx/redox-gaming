[configuration]

entry_symbol = "redox_library_init"
compatibility_minimum = "4.5"
reloadable = false

[libraries]

windows.debug.x86_64 = "res://bin/windows/redox_core.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://bin/windows/redox_core.windows.template_release.x86_64.dll"
linux.debug.x86_64 = "res://bin/linux/libredox_core.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://bin/linux/libredox_core.linux.template_release.x86_64.so"
android.debug.arm64 = "res://bin/android/libredox_core.android.template_debug.arm64.so"
android.release.arm64 = "res://bin/android/libredox_core.android.template_release.arm64.so"
